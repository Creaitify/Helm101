# Server-only database URLs. Keep real values in .env.local and deployment secrets.
# NEON_DATABASE_URL must authenticate as the `helm_app` role (nobypassrls) --
# never as neondb_owner, whose rolbypassrls silently disables tenant isolation.
# The unpooled URL (neondb_owner) is migration-only.
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=

# One-time use with `npm run db:provision-app-role` to set helm_app's password.
# Not read by the running app. Never committed with a real value.
HELM_APP_ROLE_PASSWORD=

# RLS-bypassing, SELECT-only reader used solely for cross-tenant platform admin
# views. Must be a different role from the application connection.
NEON_PLATFORM_READER_URL=

# Generate a distinct, high-entropy value for each deployed environment.
AUTH_SECRET=
ENCRYPTION_KEY=
HELM_ENV=development

# Optional OAuth providers. Configure one or both before enabling login.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Model routing only. Provider keys are added later as server-only deployment secrets.
ANTHROPIC_REASONING_MODEL=
OPENAI_COPY_MODEL=
OPENAI_EMBEDDING_MODEL=
GOOGLE_IMAGE_MODEL=
GOOGLE_VIDEO_MODEL=
