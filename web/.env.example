# Generate a distinct, high-entropy value for each deployed environment.
AUTH_SECRET=
ENCRYPTION_KEY=
HELM_ENV=development

# Optional OAuth providers. Configure one or both before enabling login.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Auth0, the hosted issuer FastAPI verifies against. All four are required
# together: with AUTH0_AUDIENCE unset the provider refuses to register, because
# Auth0 answers an audience-less request with an opaque token that carries no
# `aud` claim and cannot be verified against the JWKS.
#
# AUTH0_ISSUER takes NO trailing slash -- NextAuth appends discovery paths to it.
# helm-api's OIDC_ISSUER is the same URL but REQUIRES the trailing slash, because
# Auth0's `iss` claim carries one and the verifier compares it verbatim. The
# asymmetry is deliberate; matching them causes a token that verifies
# cryptographically and is then rejected for wrong issuer.
#
# AUTH0_AUDIENCE must equal helm-api's OIDC_AUDIENCE exactly. See
# docs/runbooks/auth0-setup.md for the dashboard steps that produce these.
AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# Base URL of the FastAPI service. The BFF calls it server-side only; it is never
# reachable from the browser.
HELM_API_BASE_URL=

# Demo mode serves every surface from fixtures and skips the helm-api tenant
# lookup. Explicit true/false always wins; when unset, demo is the default
# exactly when HELM_API_BASE_URL is unset, so a fresh checkout renders the full
# UI with zero setup.
HELM_DEMO_MODE=
