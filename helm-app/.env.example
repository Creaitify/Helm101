# Server-only database URLs. Keep real values in .env.local and deployment secrets.
# NEON_DATABASE_URL must authenticate as the `helm_app` role (nobypassrls) --
# never as neondb_owner, whose rolbypassrls silently disables tenant isolation.
# The unpooled URL (neondb_owner) is migration-only.
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=

# One-time use with `npm run db:provision-app-role` to set helm_app's password.
# Not read by the running app. Never committed with a real value.
HELM_APP_ROLE_PASSWORD=

# RLS-bypassing, SELECT-only reader used solely for cross-tenant platform admin
# views. Must be a different role from the application connection.
NEON_PLATFORM_READER_URL=

# Email of the first platform admin. Required by scripts/seed.mjs.
SEED_PLATFORM_ADMIN_EMAIL=

# Generate a distinct, high-entropy value for each deployed environment.
AUTH_SECRET=
ENCRYPTION_KEY=
HELM_ENV=development

# Optional OAuth providers. Configure one or both before enabling login.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Auth0, the hosted issuer FastAPI verifies against. All four are required
# together: with AUTH0_AUDIENCE unset the provider refuses to register, because
# Auth0 answers an audience-less request with an opaque token that carries no
# `aud` claim and cannot be verified against the JWKS.
#
# AUTH0_ISSUER takes NO trailing slash -- NextAuth appends discovery paths to it.
# helm-api's OIDC_ISSUER is the same URL but REQUIRES the trailing slash, because
# Auth0's `iss` claim carries one and the verifier compares it verbatim. The
# asymmetry is deliberate; matching them causes a token that verifies
# cryptographically and is then rejected for wrong issuer.
#
# AUTH0_AUDIENCE must equal helm-api's OIDC_AUDIENCE exactly. See
# docs/runbooks/auth0-setup.md for the dashboard steps that produce these.
AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# Base URL of the FastAPI service. The BFF calls it server-side only; it is never
# reachable from the browser.
HELM_API_BASE_URL=

# Model routing only. Provider keys are added later as server-only deployment secrets.
ANTHROPIC_REASONING_MODEL=
OPENAI_COPY_MODEL=
OPENAI_EMBEDDING_MODEL=
GOOGLE_IMAGE_MODEL=
GOOGLE_VIDEO_MODEL=
