# HELM API environment template. Copy to .env and fill in. Never commit .env.

HELM_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Application connection. Must authenticate as a role that CANNOT bypass RLS.
DATABASE_URL=

# Privileged unpooled connection used only by Alembic migrations.
DATABASE_MIGRATION_URL=

# OIDC verification. Provider-agnostic: any standards-compliant issuer works.
# The final production issuer is still an open decision; these values are the
# only thing that needs to change when it is settled.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=helm-api
OIDC_ALLOWED_ALGORITHMS=["RS256"]
OIDC_JWKS_CACHE_SECONDS=300

# Local/test only. Permits omitting the BFF workload assertion while the BFF
# does not exist. Startup fails if this is true in staging or production.
ALLOW_DEV_UNASSERTION=false

# --- Model gateway ----------------------------------------------------------
# The only provider credential in the platform. Read in exactly one place
# (app/gateway/keys.py) and never leaves the API process; workers reach models
# through the gateway's HTTP surface and hold no key of their own.
#
# Leave this blank to run against recorded fixtures instead of a live provider.
# Every surface still works — you get canned replies rather than generated ones.
ANTHROPIC_API_KEY=

# Freezes all model egress. The gateway is authoritative for this: a worker-side
# check saves a round trip but is not a control.
GATEWAY_KILL_SWITCH=false

# Default per-tenant spend cap, in integer micro-dollars. 20000000 = $20.00.
GATEWAY_DEFAULT_CAP_MICROS=20000000

# --- Knowledge corpus -------------------------------------------------------
# Where the Analyst's documentation corpus lives. Defaults to the repository
# root, which is what makes it work on a fresh clone with no configuration.
KNOWLEDGE_ROOT=

# --- Local-only escape hatch ------------------------------------------------
# Resolving a caller's identity and memberships is a database read, so with no
# DATABASE_URL there is no authenticated caller and every authenticated endpoint
# is unreachable. This substitutes a fixed, READ-ONLY local principal so the
# Analyst is usable before Postgres exists.
#
# It never weakens token verification: when a database and issuer are
# configured, the real chain runs and this is ignored. Startup fails if it is
# true in staging or production.
ALLOW_LOCAL_PRINCIPAL=false
LOCAL_PRINCIPAL_TENANT_SLUG=letstute
